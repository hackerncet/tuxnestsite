# Copy to .env for local testing; never commit real passwords or secrets.
APP_ENV=development
DATABASE_URL=sqlite:///./ncet-dev.sqlite3
PUBLIC_ORIGIN=http://localhost:8000
# One-time account bootstrap. Generate new 16+ character passwords before deploying.
# Required for docker compose self-hosting. Use a URL-safe password such as openssl rand -hex 24
POSTGRES_PASSWORD=
# Set to your actual HTTPS site domain for self-hosted production.
# PUBLIC_ORIGIN=https://your-college-host.example.edu
NCET_BOOTSTRAP_ADMIN_USERNAME=admin
NCET_BOOTSTRAP_ADMIN_PASSWORD=
# Generates: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
SETTINGS_ENCRYPTION_KEY=
NCET_BOOTSTRAP_PRINCIPAL_USERNAME=principal
NCET_BOOTSTRAP_PRINCIPAL_PASSWORD=
NCET_BOOTSTRAP_HOD_PASSWORD=
NCET_BOOTSTRAP_STAFF_PASSWORD=
NCET_BOOTSTRAP_IQAC_PASSWORD=
# Options: database (limited volume), disk (persistent mount required), s3 (recommended).
STORAGE_BACKEND=database
# UPLOAD_DIR=/var/data/ncet-uploads
# S3_BUCKET=ncet-docflow-private
# S3_ENDPOINT_URL=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION=auto

# OpenRouter key is saved by Super Admin in the app, encrypted in PostgreSQL.
# Alternatively set OPENROUTER_API_KEY as server environment variable.
OPENROUTER_API_KEY=
